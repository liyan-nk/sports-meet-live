# Sports Meet Live 2026 — Environment Configuration
# Copy this file to .env or .env.local to configure Appwrite cloud backend integration.
# Leave empty or omitted to run in standalone local mock mode.

# Appwrite Cloud API Endpoint (e.g. https://cloud.appwrite.io/v1)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Dedicated Project ID (e.g. sports-meet-live-2026)
VITE_APPWRITE_PROJECT_ID=sports-meet-live-2026

# Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=sports_meet_db
