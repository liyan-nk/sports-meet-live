# Sports Meet Live 2026 Environment Configuration
# Copy this file to .env or .env.local to configure real Supabase integration.
# Leave empty or omitted to run in standalone local mock mode.

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Public Anonymous API Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
